# Khóa API Google Gemini - lấy từ https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# --- Tùy chọn (bỏ comment để thay đổi) ---
# Model chính (mặc định: gemini-3.5-flash-lite - nhanh nhất theo đo ngày 19/11/2026)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Chuỗi model dự phòng, phân tách bằng dấu phẩy; "none" để tắt
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
# Thời gian tối đa mỗi request (giây, tối thiểu 10). Quá hạn -> chuyển model dự phòng
# GEMINI_TIMEOUT=20
# Mức thinking (ví dụ: low). Để trống = mặc định của model
# GEMINI_THINKING_LEVEL=
# Cache phản hồi LLM trên đĩa (cache/llm_responses). 0 = tắt
# LLM_CACHE=1

# --- Lưu lịch sử hỏi đáp trên MySQL (tùy chọn; bỏ trống hoặc lỗi kết nối -> tự fallback về SQLite) ---
# HISTORY_BACKEND=auto
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=dacs4_insights
