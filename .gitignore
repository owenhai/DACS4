# === Biến môi trường (chứa API key, không được commit) ===
.env

# === Dữ liệu thô từ Kaggle & dữ liệu đã xử lý Parquet (tải/tạo lại được từ ETL) ===
data/raw/
data/processed/*.parquet

# === File cơ sở dữ liệu DuckDB & lịch sử SQLite ===
