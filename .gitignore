__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd

# === Môi trường ảo Python ===
.venv/
venv/
env/

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo

# === Jupyter Notebook checkpoints ===
.ipynb_checkpoints/

